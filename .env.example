# Скопируйте в .env (он в .gitignore) и подставьте значения. run.sh / run.ps1 читают .env сами.
# Ключ облачного OCR MinerU. Без него работает только CLIP-ветка.
MINERU_TOKEN=
# 1 — включить OCR MinerU. По умолчанию 0: облачный OCR не укладывается в 10 с runner
WINE_USE_OCR=0
# Необязательно: свой интерпретатор Python 3.12 с зависимостями
# PYTHON=.venv/Scripts/python.exe
